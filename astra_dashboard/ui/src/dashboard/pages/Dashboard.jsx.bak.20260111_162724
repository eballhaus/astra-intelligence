import React, { useEffect, useState } from "react";

export default function Dashboard() {
  const [liveData, setLiveData] = useState(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);

  const CRYPTO_SET = new Set(["BTC", "ETH", "SOL", "XRP", "DOGE", "BNB", "ADA", "AVAX", "MATIC", "LINK"]);

  const isCrypto = (item) => {
    const sym = (item?.symbol ?? "").toUpperCase();
    const t = (item?.type ?? item?.asset_type ?? "").toString().toLowerCase();
    if (t.includes("crypto")) return true;
    return CRYPTO_SET.has(sym);
  };

  async function fetchData() {
    try {
      setLoading(true);
      const response = await fetch("http://127.0.0.1:5000/api/top_signals");
      if (!response.ok) throw new Error(`HTTP error! Status: ${response.status}`);
      const data = await response.json();
      setLiveData(data);
      setError(null);
    } catch (err) {
      console.error("Fetch error:", err);
      setError("Unable to load live data.");
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    fetchData();
    const interval = setInterval(fetchData, 15000);
    return () => clearInterval(interval);
  }, []);

  const rawSignals = liveData?.signals ?? {};
  const signalList = Array.isArray(rawSignals) ? rawSignals : Object.values(rawSignals);

  const stocks = signalList.filter((item) => !isCrypto(item));
  const cryptos = signalList.filter((item) => isCrypto(item));

  const formatPrice = (price) => {
    if (price === undefined || price === null) return "—";
    const num = Number(price);
    return isNaN(num) ? "—" : `$${num.toFixed(2)}`;
  };

  const formatChange = (pct) => {
    if (pct === undefined || pct === null) return "—";
    const num = Number(pct);
    if (isNaN(num)) return "—";
    return `${num > 0 ? "+" : ""}${num.toFixed(2)}%`;
  };

  return (
    <div className="dashboard-container">
      <div className="market-overview">
        <h1 className="dashboard-title">Astra Intelligence — Live Signals</h1>
        {error && <div className="error-message">{error}</div>}
      </div>

      <div className="dashboard-content">
        <div className="dashboard-grid">
          <div className="stock-column">
            <h2>Top Stocks</h2>
            <div className="card-grid">
              {loading ? (
                <div className="placeholder">Loading stocks…</div>
              ) : stocks.length === 0 ? (
                <div className="placeholder">No stock signals found</div>
              ) : (
                stocks.slice(0, 6).map((item) => {
                  const itemKey = `${item.symbol}_${item.type ?? item.asset_type ?? "stock"}`;
                  return (
                    <div key={itemKey} className="card stock-card">
                      <div className="symbol">{item.symbol ?? "—"}</div>
                      <div className="price">{formatPrice(item.price)}</div>
                      <div className="change">{formatChange(item.change_pct)}</div>
                      <div className="grade">{item.grade ?? "—"}</div>
                      <div className={`signal \${(item.signal ?? "").toLowerCase()}`}>
                        {item.signal ?? "—"}
                      </div>
                    </div>
                  );
                })
              )}
            </div>
          </div>

          <div className="crypto-column">
            <h2>Crypto</h2>
            <div className="card-grid">
              {loading ? (
                <div className="placeholder">Loading cryptos…</div>
              ) : cryptos.length === 0 ? (
                <div className="placeholder">No crypto signals found</div>
              ) : (
                cryptos.slice(0, 6).map((item) => {
                  const itemKey = `${item.symbol}_${item.type ?? item.asset_type ?? "crypto"}`;
                  return (
                    <div key={itemKey} className="card crypto-card">
                      <div className="symbol">{item.symbol ?? "—"}</div>
                      <div className="price">{formatPrice(item.price)}</div>
                      <div className="change">{formatChange(item.change_pct)}</div>
                      <div className="grade">{item.grade ?? "—"}</div>
                      <div className={`signal \${(item.signal ?? "").toLowerCase()}`}>
                        {item.signal ?? "—"}
                      </div>
                    </div>
                  );
                })
              )}
            </div>
          </div>

          <div className="chart-column">
            <h2>Market Overview</h2>
            <div className="chart-placeholder">
              <div className="placeholder">Chart placeholder</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}
