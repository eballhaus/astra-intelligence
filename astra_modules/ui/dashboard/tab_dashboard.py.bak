# -*- coding: utf-8 -*-
"""
Astra Intelligence — Dashboard Main Tab (v7-stable)
---------------------------------------------------
Stable version of the Astra Intelligence dashboard tab.
This layout preserves the original working structure and visuals.

Features:
✅ Working chart and sidebar
✅ Guardian integration
✅ Functional cards
✅ Streamlit-safe layout (no reload conflicts)
✅ Data fallback protection
"""


import pandas as pd
import streamlit as st

# -------------------------------------------------------------------
# 🔒 Guardian Integration
# -------------------------------------------------------------------
from astra_modules.guardian.guardian_v7 import GuardianV7
from astra_modules.ui.dashboard.dashboard_guardian import \
    ensure_dashboard_integrity

guardian = GuardianV7()
guardian.log("[Dashboard] 🚀 Initializing Astra Intelligence Dashboard Tab...")

# Ensure integrity check runs only once per Streamlit session
if "dashboard_checked" not in st.session_state:
    ensure_dashboard_integrity()
    st.session_state["dashboard_checked"] = True

# -------------------------------------------------------------------
# 🧠 Initialize Dashboard Session Variables
# -------------------------------------------------------------------
if "selected_symbol" not in st.session_state:
    st.session_state["selected_symbol"] = "BTC/USD"
    guardian.log("[Dashboard] 🧩 Initialized selected_symbol: BTC/USD")

# -------------------------------------------------------------------
# 📦 Dashboard Imports
# -------------------------------------------------------------------
try:
    from astra_modules.ui.dashboard.dashboard_cards import render_symbol_card
    from astra_modules.ui.dashboard.dashboard_chart import render_chart
    from astra_modules.ui.dashboard.dashboard_data import load_data
    from astra_modules.ui.dashboard.dashboard_sidebar import render_sidebar
    from astra_modules.ui.dashboard.dashboard_summary import render_summary
except Exception as e:
    guardian.log(f"[Dashboard] 🚨 Failed to import dashboard components: {e}")
    st.error("⚠️ Dashboard components failed to load.")
    st.stop()

# -------------------------------------------------------------------
# 🎨 UI Layout Setup
# -------------------------------------------------------------------
st.set_page_config(
    page_title="Astra Intelligence Dashboard",
    layout="wide",
    page_icon="🧠",
)

# -------------------------------------------------------------------
# 🎨 Astra Theme Loader (AstraGlass visual style)
# -------------------------------------------------------------------
try:
    from astra_modules.ui.dashboard.theme_loader import apply_theme

    apply_theme()
    guardian.log("[Theme] ✅ Astra visual theme applied successfully.")
except Exception:
    try:
        with open("astra_modules/ui/dashboard/astra_theme.css") as f:
            st.markdown(f"<style>{f.read()}</style>", unsafe_allow_html=True)
            guardian.log(
                "[Theme] ✅ Loaded Astra theme from CSS file (fallback).")
    except Exception as css_err:
        guardian.log(f"[Theme] ⚠️ Failed to apply Astra theme: {css_err}")

# -------------------------------------------------------------------
# 🧩 Sidebar
# -------------------------------------------------------------------
try:
    selected_tab = render_sidebar()
except Exception as e:
    guardian.log(f"[Sidebar] ⚠️ Sidebar render failed: {e}")
    st.error(f"⚠️ Sidebar error: {e}")
    selected_tab = "Overview"

# -------------------------------------------------------------------
# 📊 Data Loading
# -------------------------------------------------------------------
try:
    df = load_data(selected_tab)
    if df is None or df.empty:
        st.warning("⚠️ No data available to display.")
        guardian.log("[Dashboard] ⚠️ Empty dataset returned from load_data().")
except Exception as e:
    guardian.log(f"[Dashboard] ⚠️ Data load error: {e}")
    st.error(f"⚠️ Data load error: {e}")
    df = pd.DataFrame()

# -------------------------------------------------------------------
# 💾 Preload Key Symbol Data
# -------------------------------------------------------------------
try:
    btc_data = load_data("BTC/USD")
    aapl_data = load_data("AAPL")

    if (btc_data is None or btc_data.empty) and (aapl_data is None or aapl_data.empty):
        guardian.log(
            "[Dashboard] ⚠️ Both BTC/USD and AAPL datasets returned empty.")
        st.info("ℹ️ Using offline fallback data for visualization.")
except Exception as e:
    guardian.log(f"[Dashboard] ⚠️ Failed to preload key symbol data: {e}")
    st.warning(f"⚠️ Symbol data preload issue: {e}")
    btc_data, aapl_data = pd.DataFrame(), pd.DataFrame()

# -------------------------------------------------------------------
# 🌐 Minimalist Horizontal Market Overview
# -------------------------------------------------------------------
try:
    st.markdown("### 🌐 Market Overview")
    from astra_modules.ui.dashboard.dashboard_sidebar import \
        load_market_overview

    df_overview = load_market_overview()
    if df_overview is not None and not df_overview.empty:
        overview_symbols = ["^DJI", "^GSPC", "^IXIC", "BTC/USD"]
        df_overview = df_overview[df_overview["Symbol"].isin(overview_symbols)]

        st.markdown(
            """
            <style>
            .astra-ticker-bar {
                display: flex;
                justify-content: center;
                align-items: center;
                flex-wrap: nowrap;
                gap: 1.5rem;
                background: rgba(255, 255, 255, 0.04);
                border: 1px solid rgba(255, 255, 255, 0.08);
                border-radius: 12px;
                backdrop-filter: blur(8px);
                padding: 0.5rem 0.75rem;
                margin: 0.75rem 0 1.5rem 0;
            }
            .astra-ticker-item {
                text-align: center;
                font-family: 'Inter', sans-serif;
                color: #e5e7eb;
                min-width: 110px;
                transition: all 0.2s ease-in-out;
            }
            .astra-ticker-item:hover {
                transform: translateY(-1px);
                background: rgba(255,255,255,0.06);
                border-radius: 8px;
                padding: 0.25rem 0.5rem;
            }
            </style>
        """,
            unsafe_allow_html=True,
        )

        ticker_html = "<div class='astra-ticker-bar'>"
        for _, row in df_overview.iterrows():
            color = "#4ade80" if row["Change"] >= 0 else "#f87171"
            symbol_label = {
                "^DJI": "📈 DOW",
                "^GSPC": "💹 S&P 500",
                "^IXIC": "🧠 NASDAQ",
                "BTC/USD": "₿ BTC",
            }.get(row["Symbol"], row["Symbol"])
            ticker_html += f"""
                <div class='astra-ticker-item'>
                    <div class='ticker-symbol' style='color:{color};'>{symbol_label}</div>
                    <div class='ticker-price'>${row["Price"]:.2f}</div>
                    <div class='ticker-change' style='color:{color};'>{row["PercentChange"]:+.2f}%</div>
                </div>
            """
        ticker_html += "</div>"
        st.markdown(ticker_html, unsafe_allow_html=True)
    else:
        st.caption("⚠️ Market overview temporarily unavailable.")
except Exception as e:
    guardian.log(f"[Dashboard] ⚠️ Minimalist Market Overview failed: {e}")
    st.caption("⚠️ Unable to load market overview.")

# -------------------------------------------------------------------
# 📈 Chart Section
# -------------------------------------------------------------------
try:
    active_symbol = st.session_state.get("selected_symbol", selected_tab)
    chart_data = load_data(active_symbol)

    if chart_data is None or chart_data.empty:
        st.warning(f"⚠️ No valid data for chart rendering ({active_symbol}).")
    else:
        st.markdown(f"### 📊 {active_symbol} — Live Chart")
        render_chart(chart_data, symbol=active_symbol)
        guardian.log(f"[Chart] ✅ Chart rendered for {active_symbol}")
except Exception as e:
    guardian.log(f"[Dashboard] 🚨 Chart rendering failed: {e}")
    st.error(f"🚨 Chart rendering error: {e}")

# -------------------------------------------------------------------
# 💠 Symbol Cards & Summary — Stable v8 (No Duplicates)
# -------------------------------------------------------------------
try:
    st.markdown("---")
    st.subheader("💼 Market Performance")

    # --- Define symbol lists ---
    stock_symbols = ["AAPL", "MSFT", "NVDA", "AMZN", "TSLA", "GOOGL"]
    crypto_symbols = ["BTC/USD", "ETH/USD",
                      "SOL/USD", "ADA/USD", "XRP/USD", "DOGE/USD"]

    # --- Define columns for layout ---
    col_stocks, col_crypto, col_future = st.columns([1, 1, 1])

    # --- Scrollable wrapper style ---
    SCROLL_WRAPPER = """
    <div style="
        height: 550px;
        overflow-y: auto;
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 12px;
        background-color: rgba(255,255,255,0.03);
        padding: 10px;
    ">
        {content}
    </div>
    """

    # -------------------------------------------------------------------
    # 📈 STOCKS COLUMN
    # -------------------------------------------------------------------
    with col_stocks:
        st.markdown("### 📈 Stocks")

        for symbol in stock_symbols:
            try:
                df_symbol = load_data(symbol)

                # Determine if this symbol is currently active
                is_active = st.session_state.get("selected_symbol") == symbol

                # --- Render clickable symbol card ---
                if st.button(f"{symbol}", key=f"btn_{symbol}"):
                    st.session_state["selected_symbol"] = symbol
                    guardian.log(
                        f"[Dashboard] 🔄 Selected symbol changed to: {symbol}")

                # Render a single AstraGlass card only (no nested wrappers)
                render_symbol_card(symbol, df_symbol, active=is_active)

            except Exception as e:
                guardian.log(
                    f"[Dashboard] ⚠️ Stock card render issue: {symbol} — {e}")
                st.warning(f"⚠️ {symbol} data unavailable.")

    # -------------------------------------------------------------------
    # 💹 CRYPTO COLUMN
    # -------------------------------------------------------------------
    with col_crypto:
        st.markdown("### 💹 Crypto")

        for symbol in crypto_symbols:
            try:
                df_symbol = load_data(symbol)

                # Determine if this symbol is currently active
                is_active = st.session_state.get("selected_symbol") == symbol

                if st.button(f"{symbol}", key=f"btn_{symbol}_crypto"):
                    st.session_state["selected_symbol"] = symbol
                    guardian.log(
                        f"[Dashboard] 🔄 Selected symbol changed to: {symbol}")

                render_symbol_card(symbol, df_symbol, active=is_active)

            except Exception as e:
                guardian.log(
                    f"[Dashboard] ⚠️ Crypto card render issue: {symbol} — {e}")
                st.warning(f"⚠️ {symbol} data unavailable.")

    # ===========================================================
    # 🧠 FUTURE COLUMN (Insights placeholder)
    # ===========================================================
    with col_future:
        st.markdown("### 🧠 Insights (Coming Soon)")
        st.markdown(
            SCROLL_WRAPPER.format(
                content="<p style='color:#aaa;text-align:center;'>Reserved for Astra neural insights.</p>"
            ),
            unsafe_allow_html=True,
        )

    # ===========================================================
    # 📘 SUMMARY SECTION
    # ===========================================================
    st.markdown("---")
    render_summary()

except Exception as e:
    guardian.log(f"[Dashboard] ⚠️ Card or summary render failed: {e}")
    st.error(f"⚠️ Card or summary section error: {e}")

# -------------------------------------------------------------------
# ✅ Final Status
# -------------------------------------------------------------------
guardian.log("[Dashboard] ✅ Dashboard fully loaded and verified.")
st.success("🧠 Astra Intelligence Dashboard is active and Guardian-protected.")

# ────────────────────────────────────────────────
# 🧠 GLOBAL ERROR CAPTURE (auto-added by Astra diagnostics)
# ────────────────────────────────────────────────
import sys, traceback, streamlit as st

def global_error_hook(exc_type, exc_value, exc_traceback):
    """Global uncaught error handler for Streamlit dashboard."""
    if issubclass(exc_type, KeyboardInterrupt):
        sys.__excepthook__(exc_type, exc_value, exc_traceback)
        return
    print("\n" + "="*60)
    print("UNCAUGHT DASHBOARD ERROR")
    print("="*60)
    traceback.print_exception(exc_type, exc_value, exc_traceback)
    print("="*60 + "\n")
    try:
        st.error(f"{exc_type.__name__}: {exc_value}")
    except Exception:
        pass

sys.excepthook = global_error_hook
