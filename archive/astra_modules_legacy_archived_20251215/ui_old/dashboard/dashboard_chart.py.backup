# -*- coding: utf-8 -*-
"""
Astra Intelligence — Dashboard Chart Renderer (v4.4 LiveFix)
-------------------------------------------------------------
Handles interactive Plotly chart rendering with real candlesticks,
volume, and technical indicators (MA, Bollinger, RSI, MACD).

🧠 Features:
✅ Live OHLC candlesticks (green = up, red = down)
✅ MA20 + MA50
✅ Bollinger Bands
✅ Volume bars
✅ RSI + MACD below price
✅ Click indicators in legend to show/hide
✅ Guardian-safe rendering
"""

import pandas as pd
import plotly.graph_objects as go
from astra_modules.guardian.guardian_v6 import guardian_log


def render_chart(df: pd.DataFrame, symbol: str):
    """Render full technical chart with indicators."""
    try:
        guardian.log(f"[Chart] 📊 Rendering chart for {symbol}")

        # Ensure proper columns exist
        required = {"open", "high", "low", "close", "volume"}
        if not required.issubset(df.columns):
            guardian.log(f"[Chart] ⚠️ Missing columns for {symbol}, cannot plot.")
            return

        df = df.sort_values("timestamp")

        # Compute indicators
        df["MA20"] = df["close"].rolling(window=20).mean()
        df["MA50"] = df["close"].rolling(window=50).mean()
        df["BB_MID"] = df["close"].rolling(window=20).mean()
        df["BB_STD"] = df["close"].rolling(window=20).std()
        df["BB_UPPER"] = df["BB_MID"] + 2 * df["BB_STD"]
        df["BB_LOWER"] = df["BB_MID"] - 2 * df["BB_STD"]

        # RSI
        delta = df["close"].diff()
        gain = (delta.where(delta > 0, 0)).rolling(14).mean()
        loss = (-delta.where(delta < 0, 0)).rolling(14).mean()
        rs = gain / loss
        df["RSI"] = 100 - (100 / (1 + rs))

        # MACD
        df["EMA12"] = df["close"].ewm(span=12, adjust=False).mean()
        df["EMA26"] = df["close"].ewm(span=26, adjust=False).mean()
        df["MACD"] = df["EMA12"] - df["EMA26"]
        df["Signal"] = df["MACD"].ewm(span=9, adjust=False).mean()

        # Create figure
        fig = go.Figure()

        # 🕯️ Candlestick trace
        fig.add_trace(
            go.Candlestick(
                x=df["timestamp"],
                open=df["open"],
                high=df["high"],
                low=df["low"],
                close=df["close"],
                name=f"{symbol} Price",
                increasing_line_color="#22C55E",
                decreasing_line_color="#EF4444",
                increasing_fillcolor="#22C55E",
                decreasing_fillcolor="#EF4444",
                showlegend=True,
            )
        )

        # MA lines
        fig.add_trace(
            go.Scatter(
                x=df["timestamp"],
                y=df["MA20"],
                mode="lines",
                name="MA20",
                line=dict(color="#3B82F6", width=1.3),
                visible="legendonly",
            )
        )
        fig.add_trace(
            go.Scatter(
                x=df["timestamp"],
                y=df["MA50"],
                mode="lines",
                name="MA50",
                line=dict(color="#EAB308", width=1.3),
                visible="legendonly",
            )
        )

        # Bollinger Bands
        fig.add_trace(
            go.Scatter(
                x=df["timestamp"],
                y=df["BB_UPPER"],
                mode="lines",
                name="Bollinger Upper",
                line=dict(color="rgba(167,243,208,0.4)", width=1),
                visible="legendonly",
            )
        )
        fig.add_trace(
            go.Scatter(
                x=df["timestamp"],
                y=df["BB_LOWER"],
                mode="lines",
                name="Bollinger Lower",
                line=dict(color="rgba(167,243,208,0.4)", width=1),
                fill="tonexty",
                visible="legendonly",
            )
        )

        # Volume bars
        fig.add_trace(
            go.Bar(
                x=df["timestamp"],
                y=df["volume"],
                name="Volume",
                marker_color="rgba(148,163,184,0.4)",
                yaxis="y2",
                visible="legendonly",
            )
        )

        # RSI (separate subplot)
        rsi_fig = go.Scatter(
            x=df["timestamp"],
            y=df["RSI"],
            mode="lines",
            name="RSI (14)",
            line=dict(color="#8B5CF6", width=1),
            visible="legendonly",
            yaxis="y3",
        )

        # MACD (separate subplot)
        macd_fig = go.Scatter(
            x=df["timestamp"],
            y=df["MACD"],
            mode="lines",
            name="MACD",
            line=dict(color="#F97316", width=1),
            visible="legendonly",
            yaxis="y4",
        )
        signal_fig = go.Scatter(
            x=df["timestamp"],
            y=df["Signal"],
            mode="lines",
            name="Signal",
            line=dict(color="#22D3EE", width=1),
            visible="legendonly",
            yaxis="y4",
        )

        # Combine all traces
        fig.add_trace(rsi_fig)
        fig.add_trace(macd_fig)
        fig.add_trace(signal_fig)

        # Layout configuration
        fig.update_layout(
            title=f"{symbol} — Technical Chart",
            xaxis=dict(title="Date", rangeslider_visible=False),
            yaxis=dict(title="Price", side="right"),
            yaxis2=dict(
                title="Volume",
                overlaying="y",
                side="left",
                showgrid=False,
                visible=False,
            ),
            yaxis3=dict(
                title="RSI",
                overlaying="y",
                side="right",
                position=0.05,
                showgrid=False,
                visible=False,
            ),
            yaxis4=dict(
                title="MACD",
                overlaying="y",
                side="right",
                position=0.95,
                showgrid=False,
                visible=False,
            ),
            height=700,
            paper_bgcolor="rgba(15,23,42,1)",
            plot_bgcolor="rgba(15,23,42,1)",
            font=dict(color="#E5E7EB"),
            legend=dict(
                orientation="h",
                yanchor="bottom",
                y=-0.25,
                xanchor="center",
                x=0.5,
                bgcolor="rgba(15,23,42,0.5)",
                bordercolor="rgba(255,255,255,0.1)",
                borderwidth=1,
            ),
        )

        import streamlit as st

        st.plotly_chart(fig, use_container_width=True, config={"displayModeBar": True})
        guardian.log(f"[Chart] ✅ Rendered {symbol} successfully")

    except Exception as e:
        guardian.log(f"[Chart] 🚨 Chart render failed for {symbol}: {e}")
