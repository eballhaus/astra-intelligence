import os, json
from datetime import datetime
from astra_dashboard.universe.universe_builder import build_universe
from astra_dashboard.astra_modules.engine.ranking_engine import RankingEngine
from astra_dashboard.astra_modules.fetch.fetch_stock import fetch_stock
from astra_dashboard.astra_modules.fetch.fetch_crypto import fetch_crypto

def rebuild_cache():
    print("[Astra CacheBuilder] 🚀 Rebuilding live ranked results (Phase 2.3)...")

    engine = RankingEngine()
    symbols = build_universe()
    if not symbols or not isinstance(symbols, list):
        raise SystemExit("❌ Universe unavailable or invalid")

    ranked_results = []
    crypto_set = {"BTC","ETH","SOL","BNB","XRP","ADA"}

    for sym in symbols:
        asset_type = "crypto" if sym.upper() in crypto_set else "stock"

        try:
            # Fetch OHLC data
            df = fetch_crypto(sym) if asset_type == "crypto" else fetch_stock(sym)
            if df is None or df.empty:
                print(f"⚠️ No data for {sym}")
                continue

            # Score + grade
            score = engine.get_score(df)
            if score is None:
                continue

            grade = engine.get_grade(score)

            ranked_results.append({
                "symbol": sym,
                "confidence": float(score),
                "grade": grade,
                "prediction": None,
                "stop": None,
                "reason": f"{asset_type.upper()} evaluated via RankingEngine"
            })

        except Exception as e:
            print(f"⚠️ Fetch/eval failed for {sym}: {e}")

    if not ranked_results:
        raise SystemExit("❌ No valid results produced")

    os.makedirs("state", exist_ok=True)
    cache = {
        "timestamp": datetime.utcnow().isoformat(),
        "ranked_results": ranked_results
    }

    with open("state/cache_store.json", "w", encoding="utf-8") as f_out:
        json.dump(cache, f_out, indent=2)

    print(f"[Astra CacheBuilder] ✅ Cached {len(ranked_results)} real engine results")

if __name__ == "__main__":
    rebuild_cache()