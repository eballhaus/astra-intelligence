  "pit_requirement": "HISTORICAL_NEWS_EVIDENCE_GATE",
  "rate_budget": {
    "calls_per_minute": 20
  },
  "resource_budget": {
    "max_calls": 10,
    "max_bytes": 83886080,
    "max_in_flight": 1,
    "min_free_bytes": 268435456
  },
  "resume_state": {},
  "acquisition_started": false,
  "historical_replay_only": true,
  "evidence_class": "HISTORICAL_REPLAY",
